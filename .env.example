# A publicação deve manter o login obrigatório.
AGENDA_AUTH_REQUIRED=1
AGENDA_USERNAME=vendedor
AGENDA_PASSWORD_HASH=pbkdf2_sha256$600000$SAL_GERADO$HASH_GERADO
AGENDA_AUTH_PEPPER=SEGREDO_GERADO
AGENDA_USER_NAME=Nome do vendedor
AGENDA_ROLE=seller
AGENDA_SEED_DEMO=0
AGENDA_TIMEZONE=America/Sao_Paulo

# O Railway fornece esta variável ao conectar um serviço PostgreSQL.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Recomendado no piloto publicado para os lembretes funcionarem sem o Mac aberto.
AGENDA_NOTIFICATION_EMAIL=vendedor@empresa.com
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario-smtp
SMTP_PASSWORD=senha-smtp
SMTP_FROM=agenda@empresa.com
SMTP_STARTTLS=1
